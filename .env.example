MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=silkknot
AUTH_SECRET=replace-with-a-long-random-string
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_server_only
# Webhook secret from Razorpay Dashboard → Webhooks. Required in production. Not the key secret.
RAZORPAY_WEBHOOK_SECRET=
# Local staging rehearsal only. Lets npm run start accept rzp_test_ keys while DELHIVERY_ENVIRONMENT=staging.
# Leave this empty on a live store. A live Delhivery environment still requires live Razorpay keys.
CHECKOUT_STAGING_REHEARSAL=
# Secret for POST /api/checkout/reconcile (header x-silkknot-reconcile). Schedule this outside the app.
# The same call also retries shipment tasks and polls active Delhivery tracking.
CHECKOUT_RECONCILE_SECRET=

# Delhivery Express API. Do not use NEXT_PUBLIC_ for any of these.
# Set DELHIVERY_ENABLED=0 to use labeled store-managed rates without calling Delhivery.
# DELHIVERY_MODE=mock creates local TEST waybills and never calls Delhivery. Leave it empty for a real API rehearsal.
# Mock mode is ignored when NODE_ENV=production.
# Staging rehearsal: ENVIRONMENT=staging, BASE_URL empty, a staging token, LIVE_READS=1.
# That uses https://staging-express.delhivery.com. A staging waybill does not dispatch a live rider.
# PIN, date, and price reads work in npm run dev. With DELHIVERY_LIVE_SHIPMENT_CREATION_ENABLED=1,
# a confirmed order books a waybill immediately on the staging host. Pickup and cancel use that same switch.
# The production host still books only when NODE_ENV=production. Keep ENVIRONMENT=staging until you intend to book live parcels.
DELHIVERY_MODE=
DELHIVERY_LIVE_READS_ENABLED=0
DELHIVERY_LIVE_SHIPMENT_CREATION_ENABLED=0
DELHIVERY_API_TOKEN=
DELHIVERY_ENABLED=
DELHIVERY_ENVIRONMENT=staging
DELHIVERY_BASE_URL=
DELHIVERY_PICKUP_LOCATION=
# 6-digit PIN of that warehouse. Expected TAT uses this as the origin. Delhivery does not return it from the pickup name.
DELHIVERY_ORIGIN_PIN=
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
# Optional. Delhivery's tracking docs do not publish a signature. Push is rejected unless this is set
# and Delhivery sends Authorization: Token <this value>.
DELHIVERY_WEBHOOK_TOKEN=

# Checkout does not charge these paise amounts. Shipping is Delhivery’s estimate plus ₹10, rounded to the nearest rupee.
# Estimate labels are a fallback when Expected TAT does not return a date. Leave them empty to show no date.
SHIPPING_STANDARD_PAISE=7900
SHIPPING_EXPRESS_PAISE=0
SHIPPING_FREE_ABOVE_PAISE=99900
SHIPPING_STANDARD_ETA=
SHIPPING_EXPRESS_ETA=
SHIPPING_COD_ENABLED=0
SHIPPING_COD_FEE_PAISE=0
SHIPPING_BOOKING_MODE=auto
# Fallback grams for one product that has no weight yet. The parcel sent to Delhivery is the sum of each product's approximate weight times quantity.
SHIPPING_DEFAULT_WEIGHT_GRAMS=500


# Email. Nodemailer SMTP. Port 465 is implicit TLS. Port 587 turns on STARTTLS.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER is that Gmail address, SMTP_PASS is an app password.
# A custom address such as support@silkenknot.com uses the same variables once that mailbox exists.
# SMTP_FROM should match the authenticated mailbox. Spaces in SMTP_PASS are stripped.
# SMTP_INBOX receives the contact form. It defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Silken Knot <support@silkenknot.com>"
SMTP_INBOX=

# OTP delivery. Leave SMTP empty locally and set OTP_DEV_SINK=1.
# OTP_DEV_SINK is ignored when NODE_ENV=production.
OTP_DEV_SINK=1
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Bunny Storage + CDN (server-only — never use NEXT_PUBLIC_ for these).
# Studio product photos upload to Storage and are served from the pull zone.
# Existing files under public/silknknot stay local.
#
# Local: copy into .env.local and restart npm run dev.
# Production: set the same keys in the host env panel (e.g. Vercel).
#
# BUNNY_CDN_URL = public pull zone, e.g. https://your-zone.b-cdn.net (no trailing slash)
# BUNNY_STORAGE_HOST must match the storage zone region:
#   Falkenstein default → https://storage.bunnycdn.com
#   Singapore → https://sg.storage.bunnycdn.com
#   New York → https://ny.storage.bunnycdn.com
#   Los Angeles → https://la.storage.bunnycdn.com
#
# Object keys: products/{productId}/main|gallery|variants/.../*.webp
# If a Storage password was ever exposed via NEXT_PUBLIC_*, rotate it in Bunny.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOST=https://storage.bunnycdn.com
BUNNY_CDN_URL=
# Optional media limits
# MEDIA_MAX_BYTES=6291456
# MEDIA_MAX_WIDTH=4096
# MEDIA_MAX_HEIGHT=4096
# MEDIA_UPLOAD_RATE_LIMIT=40


# Optional tuning
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=60
# OTP_DEST_LIMIT=5
# OTP_DEST_WINDOW_SECONDS=3600
# SESSION_IDLE_SECONDS=1209600
# SESSION_ABSOLUTE_SECONDS=2592000
